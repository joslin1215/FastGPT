# NextAuth
# Generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://root:mongo@localhost:27017/fastgpt?authSource=admin
# Default root user and password, only for docker build. Not for production.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo

# Default pgsql config
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST=
# POSTGRES_PORT=

# File
# S3/minio Refer to https://www.fastgpt.in/docs/installation/minio/
# DefaultMinioAddress=http://localhost:9000
# DefaultMinioAccessKey=
# DefaultMinioSecretKey=
# DefaultMinioBucketName=fastgpt

# local file Refer to https://www.fastgpt.in/docs/installation/fileLocal/
# LocalFileStoragePath=

# oneapi base url. Not required. Refer to https://www.fastgpt.in/docs/installation/oneapi/
# DefaultOneApiHost=

# openaiproxy base url. Not required. Refer to https://www.fastgpt.in/docs/development/custom-llm/
# DefaultOpenaiProxyUrl=

# AI
# You need to get an OpenAI API key from https://openai.com/
# DefaultOpenAIKey=
# DefaultOpenAIBaseUrl=
# You can override the model used for chat.
# DefaultChatModel=gpt-3.5-turbo
# You can override the model used for query. It is recommended to use a cheap and fast model.
# DefaultQAModel=gpt-3.5-turbo
# You can override the model used for extract data. It is recommended to use a cheap and fast model.
# DefaultCQModel=gpt-3.5-turbo
# You can override the model used for tool choice.
# DefaultToolChoiceModel=gpt-4-1106-preview
# You can override the model used for audio speech.
# DefaultAudioSpeechModel=tts-1
# Vector store. PGVector or Milvus. Refer to https://www.fastgpt.in/docs/installation/vector/
# DefaultVectorStore=pgvector
# Milvus config
# DefaultMilvusAddress=
# DefaultMilvusUsername=
# DefaultMilvusPassword=
# DefaultMilvusDbName=

# Community version function control
# docs: https://www.fastgpt.in/docs/development/configuration/
# System Notification, The maximum length is 150 characters
# SystemTip=
# Whether to enable the commercial function, close it for free
# Commercial=false
# Whether to enable the community function (invitation and share)
# Community=false
# Whether to enable the plugin function (http and app)
# Plugin=false
# Whether to enable the dataset function
# Dataset=true
# Whether to enable the explore function
# Explore=false
# Whether to enable the cron job
# Cron=true
# Whether to enable the website sync function
# WebSiteSync=false
# Whether to enable the pdf function
# StorePdf=false

# Scheduled task concurrency, default is 2
# ScheduledTaskConcurrency=2

# Max history for chat, default is 20
# MaxHistory=20

# Max file size for upload, default is 50MB
# MaxUploadFileSize=50

# Max token for whisper, default is 24MB
# MaxWhisperToken=24

# Default language for i18n
# DefaultLanguage=

# Root user's openai key. It is used for dataset training.
# RootOpenAiKey=

# Price for root user. Unit: yuan/1k tokens. format: model=price,model=price
# RootUserModelsPrice=

# Default callback url for oauth login
# DefaultOauthLoginCallback=

# Disable password login, only oauth login
# DisablePasswordLogin=false

# Disable register
# DisableRegister=false

# Disable account settings
# DisableAccountSettings=false

# Disable team
# DisableTeam=false

# Disable billing
# DisableBilling=false

# Disable share model
# DisableShareModel=false

# Disable contact
# DisableContact=false

# Github client id and secret for oauth login
# GithubClientId=
# GithubClientSecret=

# Gitlab client id and secret for oauth login. Refer to https://www.fastgpt.in/docs/installation/saas-gitlab-login/
# GitlabClientId=
# GitlabClientSecret=
# GitlabAllowedUsers=
# GitlabBaseUrl=

# Google client id and secret for oauth login. Refer to https://www.fastgpt.in/docs/installation/saas-google-login/
# GoogleClientId=
# GoogleClientSecret=

# Wechat official account appid and secret for oauth login. Refer to https://www.fastgpt.in/docs/installation/saas-wechat-login/
# WechatAppId=
# WechatAppSecret=

# Feishu client id and secret for oauth login. Refer to https://www.fastgpt.in/docs/installation/saas-feishu-login/
# FeishuClientId=
# FeishuClientSecret=
# FeishuRedirectUri=

# DingTalk client id and secret for oauth login. Refer to https://www.fastgpt.in/docs/installation/saas-dingtalk-login/
# DingTalkClientId=
# DingTalkClientSecret=
# DingTalkRedirectUri=

# Aliyun sms config. Refer to https://www.fastgpt.in/docs/installation/saas-aliyun-sms/
# AliyunSmsAccessKeyId=
# AliyunSmsAccessKeySecret=
# AliyunSmsSignName=
# AliyunSmsTemplateCode=

# Email config. Refer to https://www.fastgpt.in/docs/installation/saas-email/
# EmailHost=
# EmailPort=
# EmailUser=
# EmailPass=
# EmailFrom=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ENABLE_ELASTICSEARCH=false

# Log level. Default is info. options: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info

# Max request per minute for openai. Default is 100.
# OPENAI_MAX_RPM=100
# Max request per minute for fastgpt. Default is 100.
# FASTGPT_MAX_RPM=100
# Max request per minute for vector. Default is 100.
# VECTOR_MAX_RPM=100
# Max request per minute for other. Default is 100.
# OTHER_MAX_RPM=100
# Max request per minute for file. Default is 10.
# FILE_MAX_RPM=10

# proxy url for http request. e.g. http://localhost:7890
# PROXY_URL=

# Retry times for http request. Default is 3.
# HTTP_RETRY_TIMES=3

# Retry delay for http request. Default is 500ms.
# HTTP_RETRY_DELAY=500

# Timeout for http request. Default is 30s.
# HTTP_TIMEOUT=30000
# Timeout for llm request. Default is 120s.
# LLM_TIMEOUT=120000
# Timeout for vector request. Default is 60s.
# VECTOR_TIMEOUT=60000

# Sensitive words. Separated by comma. e.g. word1,word2
# SENSITIVE_WORDS=

# Whether to enable sensitive check. Default is false.
# ENABLE_SENSITIVE_CHECK=false

# Whether to enable image generation. Default is false.
# ENABLE_IMAGE_GENERATION=false

# Image generation model. Default is dall-e-2.
# IMAGE_GENERATION_MODEL=dall-e-2

# Image generation quality. Default is standard. options: standard, hd
# IMAGE_GENERATION_QUALITY=standard

# Image generation style. Default is vivid. options: vivid, natural
# IMAGE_GENERATION_STYLE=vivid

# Image generation size. Default is 1024x1024. options: 256x256, 512x512, 1024x1024, 1792x1024, 1024x1792
# IMAGE_GENERATION_SIZE=1024x1024

# Image generation n. Default is 1.
# IMAGE_GENERATION_N=1
# Max image generation n. Default is 1.
# MAX_IMAGE_GENERATION_N=1

# Image generation price. Unit: yuan/image. format: model=price,model=price
# IMAGE_GENERATION_PRICE=dall-e-2=0.04

# Whether to enable image understanding. Default is false.
# ENABLE_IMAGE_UNDERSTANDING=false

# Image understanding model. Default is gpt-4-vision-preview.
# IMAGE_UNDERSTANDING_MODEL=gpt-4-vision-preview

# Max detail for image understanding. Default is auto. options: auto, low, high
# MAX_DETAIL_FOR_IMAGE_UNDERSTANDING=auto

# Max tokens for image understanding. Default is 2000.
# MAX_TOKENS_FOR_IMAGE_UNDERSTANDING=2000

# User max model amount. Default is 20.
# USER_MAX_MODEL_AMOUNT=20

# User max app amount. Default is 20.
# USER_MAX_APP_AMOUNT=20

# User max dataset amount. Default is 20.
# USER_MAX_DATASET_AMOUNT=20

# User max plugin amount. Default is 20.
# USER_MAX_PLUGIN_AMOUNT=20

# User max dataset collection amount. Default is 20.
# USER_MAX_DATASET_COLLECTION_AMOUNT=20

# User max dataset data amount. Default is 1000.
# USER_MAX_DATASET_DATA_AMOUNT=1000

# User max dataset training data amount. Default is 10000.
# USER_MAX_DATASET_TRAINING_DATA_AMOUNT=10000

# User max team amount. Default is 3.
# USER_MAX_TEAM_AMOUNT=3

# User max team member amount. Default is 5.
# USER_MAX_TEAM_MEMBER_AMOUNT=5

# User max token buffer. Default is 0. Unit: token.
# USER_MAX_TOKEN_BUFFER=0

# User max file collection amount. Default is 20.
# USER_MAX_FILE_COLLECTION_AMOUNT=20

# User max table collection amount. Default is 20.
# USER_MAX_TABLE_COLLECTION_AMOUNT=20

# User max qa collection amount. Default is 20.
# USER_MAX_QA_COLLECTION_AMOUNT=20

# User max cr collection amount. Default is 20.
# USER_MAX_CR_COLLECTION_AMOUNT=20

# User max manual collection amount. Default is 20.
# USER_MAX_MANUAL_COLLECTION_AMOUNT=20

# User max external file collection amount. Default is 20.
# USER_MAX_EXTERNAL_FILE_COLLECTION_AMOUNT=20

# User max website collection amount. Default is 20.
# USER_MAX_WEBSITE_COLLECTION_AMOUNT=20

# User max http plugin amount. Default is 20.
# USER_MAX_HTTP_PLUGIN_AMOUNT=20

# User max dataset plugin amount. Default is 20.
# USER_MAX_DATASET_PLUGIN_AMOUNT=20

# User max run app plugin amount. Default is 20.
# USER_MAX_RUN_APP_PLUGIN_AMOUNT=20

# User max tool choice plugin amount. Default is 20.
# USER_MAX_TOOL_CHOICE_PLUGIN_AMOUNT=20

# User max assign agent plugin amount. Default is 20.
# USER_MAX_ASSIGN_AGENT_PLUGIN_AMOUNT=20
